# Copy to .env and change the password. .env is git-ignored.
POSTGRES_DB=honeypot
POSTGRES_USER=honeypot
POSTGRES_PASSWORD=change-me

# Used by the loader and tests (PowerShell: $env:DATABASE_URL = "...").
# Use 127.0.0.1, not localhost: on Windows "localhost" tries IPv6 first and
# hangs, because Docker only publishes the port on IPv4.
DATABASE_URL=postgresql://honeypot:change-me@127.0.0.1:5432/honeypot

# Lab Cowrie hostname. Do not commit the real sensor's fake hostname/users:
# publishing them makes the sensor easy to fingerprint.
COWRIE_HOSTNAME=lab-sensor
