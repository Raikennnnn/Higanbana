[Unit]
Description=Cowrie SSH honeypot
After=network-online.target nftables.service
Wants=network-online.target

[Service]
User=cowrie
Group=cowrie
WorkingDirectory=/opt/cowrie/cowrie
Environment=PYTHONPATH=/opt/cowrie/cowrie/src
# umask 0027: logs are group-readable so the logpull user (in group cowrie) can copy them
ExecStart=/opt/cowrie/cowrie-env/bin/twistd --umask=0027 --nodaemon --pidfile= -l - cowrie
Restart=on-failure
RestartSec=5

# Sandbox: Cowrie only needs to read its code and write its log/state dirs.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/log/cowrie /var/lib/cowrie
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
MemoryMax=512M
TasksMax=256

[Install]
WantedBy=multi-user.target
