# Copy to sensor.env next to setup-sensor.sh ON THE VM. sensor.env is
# git-ignored: its values fingerprint the sensor, so they never go in the repo.

# The user your cloud created with your SSH key (it already has sudo).
ADMIN_USER=azureuser

# Admin sshd port. Pick a random high port (e.g. 40000-60000) and allow it in
# the cloud firewall for YOUR IP only.
ADMIN_PORT=

# A separate key used only to pull logs (make it with: ssh-keygen -t ed25519 -f logpull).
PULL_PUBKEY="ssh-ed25519 AAAA... logpull"

# What attackers see. Don't use Cowrie's defaults (svr04, the Debian banner):
# they are well-known honeypot fingerprints.
COWRIE_HOSTNAME=
COWRIE_SSH_VERSION="SSH-2.0-OpenSSH_9.6p1 Ubuntu-3ubuntu13.5"

COWRIE_TAG=v3.0.15

# Cloud platform addresses the sensor may still reach (DHCP, VM agent, metadata).
# Azure: "168.63.129.16, 169.254.169.254"   Google Cloud: "169.254.169.254"
PLATFORM_IPS="168.63.129.16, 169.254.169.254"

LOG_RETENTION_DAYS=14
